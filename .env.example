# =====================
# Database Config
# =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database
DB_USER=root
DB_PASS=

# =====================
# Python interpreter for config/tcp.php + config/rs485.php (meter "Test connection").
# Runs as the account Apache runs under — a per-user Python install is NOT on its
# PATH (nor visible to the "py" launcher), so give a FULL path to python.exe.
# Single-quote it so backslashes stay literal. Linux/macOS: PYTHON_BIN=python3
# =====================
PYTHON_BIN='C:\Path\To\Python\python.exe'
